# Server Configuration
PORT=8000
SESSION_SECRET=your-session-secret-key-here

# Database Configuration (MySQL)
DATABASE_URL="mysql://root:yourpassword@localhost:3306/hotel_manager"

# Google OAuth2.0 Configuration
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:8000/auth/google/callback"

# Local payment simulation; set to mock to test without MoMo credentials.
# Mock mode is disabled automatically when NODE_ENV=production.
MOMO_MODE=mock

# MoMo Sandbox credentials are needed only when MOMO_MODE is not "mock".
MOMO_PARTNER_CODE="MOMOBKUN20180529"
MOMO_ACCESS_KEY="your-momo-access-key"
MOMO_SECRET_KEY="your-momo-secret-key"
MOMO_ENDPOINT="https://test-payment.momo.vn/v2/gateway/api/create"
MOMO_REDIRECT_URL="http://localhost:8000/payment/momo/callback"
# For real MoMo IPN, this must be a public HTTPS URL reachable by MoMo.
MOMO_IPN_URL="https://your-public-domain.example/payment/momo/ipn"

# Groq Cloud AI API Configuration (Llama 3)
GROQ_API_KEY="gsk_your_groq_api_key_here"
