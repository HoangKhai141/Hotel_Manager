<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="utf-8" />
  <title>Hotelier</title>
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <meta content="" name="keywords" />
  <meta content="" name="description" />

  <link href="/client/img/favicon.ico" rel="icon" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700&family=Montserrat:wght@400;500;600;700&display=swap"
    rel="stylesheet" />

  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet" />

  <link href="/client/lib/animate/animate.min.css" rel="stylesheet" />
  <link href="/client/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet" />
  <link href="/client/lib/tempusdominus/css/tempusdominus-bootstrap-4.min.css" rel="stylesheet" />

  <link href="/client/css/bootstrap.min.css" rel="stylesheet" />
  <link href="/client/css/style.css" rel="stylesheet" />

  <style>
    .navbar .dropdown-menu {
      min-width: 300px;
      right: 0;
      left: auto;
      padding: 12px !important;
      border: 1px solid #e5e9ef;
      border-radius: 6px;
      box-shadow: 0 16px 36px rgba(15, 23, 43, .18);
    }

    .avatar-dropdown-img {
      width: 64px;
      height: 64px;
      flex: 0 0 64px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid #fff;
      box-shadow: 0 2px 12px rgba(15, 23, 43, .16);
    }

    .account-menu-profile {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 8px;
      padding: 4px 6px 14px;
      border-bottom: 1px solid #e9edf2;
    }

    .account-menu-identity {
      min-width: 0;
    }

    .account-menu-name {
      color: var(--dark);
      font-weight: 700;
      line-height: 1.35;
      overflow-wrap: anywhere;
    }

    .account-menu-email {
      margin-top: 4px;
      color: #687386;
      font-size: 13px;
      overflow-wrap: anywhere;
    }

    .account-menu-link {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 12px;
      border-radius: 4px;
    }

    .account-menu-link i {
      width: 16px;
      color: var(--primary);
      text-align: center;
    }

    .account-menu-link:hover {
      background: var(--light);
      color: var(--dark);
    }

    .account-menu-logout {
      width: 100%;
      border: 0;
      background: transparent;
      text-align: left;
    }

    @media (min-width: 992px) {
      .site-brand-column {
        flex: 0 0 22%;
        max-width: 22%;
      }

      .site-brand-column .navbar-brand h1 {
        font-size: 32px;
      }

      .site-nav-column {
        flex: 0 0 78%;
        max-width: 78%;
      }

      .dropdown:hover .dropdown-menu {
        display: block;
        margin-top: 0;
      }

      .navbar-nav.justify-content-around {
        flex-grow: 1;
        transform: translateX(-24px);
      }

      .navbar-dark .navbar-nav .nav-link {
        font-size: 1.1rem;
      }
    }
  </style>
</head>

<body>
  <div class="container-fluid bg-white p-0">
    <!-- Spinner Start -->
    <div id="spinner"
      class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
      <div class="spinner-border text-primary" style="width: 3rem; height: 3rem" role="status">
        <span class="sr-only">Đang tải...</span>
      </div>
    </div>
    <!-- Spinner End -->

    <!-- Header Start -->
    <div class="container-fluid bg-dark px-0">
      <div class="row gx-0">
        <div class="col-lg-3 bg-dark d-none d-lg-block site-brand-column">
          <a href="/" class="navbar-brand w-100 h-100 m-0 p-0 d-flex align-items-center justify-content-center">
            <h1 class="m-0 text-primary text-uppercase">Hotelier</h1>
          </a>
        </div>

        <div class="col-lg-9 site-nav-column">
          <!-- Top Bar -->
          <% if (typeof user !=='undefined' && user) { %>
            <div class="row gx-0 bg-white d-none d-lg-flex">
              <div class="col-lg-7 px-5 text-start">
                <div class="h-100 d-inline-flex align-items-center py-2 me-4">
                  <i class="fa fa-user text-primary me-2"></i>
                  <p class="mb-0">
                    <%= user.fullName %>
                  </p>
                </div>
                <div class="h-100 d-inline-flex align-items-center py-2">
                  <i class="fa fa-envelope text-primary me-2"></i>
                  <p class="mb-0">
                    <%= user.username %>
                  </p>
                </div>
              </div>
              <% } else { %>
                <div class="row gx-0 bg-white d-none d-lg-flex">
                  <div class="col-lg-7 px-5 text-start">
                    <div class="h-100 d-inline-flex align-items-center py-2 me-4">
                      <i class="fa fa-star text-primary me-2"></i>
                      <p class="mb-0">Chào mừng đến với Hotelier</p>
                    </div>
                  </div>
                  <% } %>
                    <div class="col-lg-5 px-5 text-end">
                      <div class="d-inline-flex align-items-center py-2">
                        <a class="me-3" href=""><i class="fab fa-facebook-f"></i></a>
                        <a class="me-3" href=""><i class="fab fa-twitter"></i></a>
                        <a class="me-3" href=""><i class="fab fa-linkedin-in"></i></a>
                        <a class="me-3" href=""><i class="fab fa-instagram"></i></a>
                        <a class="" href=""><i class="fab fa-youtube"></i></a>
                      </div>
                    </div>
                </div>

                <!-- Navbar -->
                <nav class="navbar navbar-expand-lg bg-dark navbar-dark p-3 px-lg-4">
                  <a href="/" class="navbar-brand d-block d-lg-none">
                    <h1 class="m-0 text-primary text-uppercase">Hotelier</h1>
                  </a>
                  <button type="button" class="navbar-toggler" data-bs-toggle="collapse"
                    data-bs-target="#navbarCollapse">
                    <span class="navbar-toggler-icon"></span>
                  </button>

                  <div class="collapse navbar-collapse justify-content-between" id="navbarCollapse">
                    <div class="navbar-nav py-0 justify-content-around">
                      <a href="/" class="nav-item nav-link">Trang Chủ</a>
                      <a href="/team" class="nav-item nav-link">Về Chúng Tôi</a>
                      <a href="/service" class="nav-item nav-link">Dịch Vụ</a>
                      <a href="/rooms" class="nav-item nav-link">Phòng</a>
                    </div>

                    <div class="my-auto">
                      <% if (typeof user !=='undefined' && user) { %>
                        <div class="dropdown">
                          <a href="#" class="dropdown" role="button" id="dropdownMenuLink" data-bs-toggle="dropdown"
                            aria-expanded="false">
                            <i class="fas fa-user fa-2x text-white"></i>
                          </a>
                          <ul class="dropdown-menu dropdown-menu-end account-menu" aria-labelledby="dropdownMenuLink">
                            <li class="account-menu-profile">
                              <img
                                class="avatar-dropdown-img"
                                src="<%= user.avatar ? '/images/avatar/' + user.avatar : '/client/img/user.jpg' %>"
                                alt="Ảnh đại diện của <%= user.fullName || user.username %>"
                              />
                              <div class="account-menu-identity">
                                <div class="account-menu-name"><%= user.fullName || user.username %></div>
                                <div class="account-menu-email"><%= user.username %></div>
                              </div>
                            </li>
                            <li>
                              <a class="dropdown-item account-menu-link" href="/profile">
                                <i class="fas fa-user-circle" aria-hidden="true"></i>Quản lý tài khoản
                              </a>
                            </li>
                            <li>
                              <a class="dropdown-item account-menu-link" href="/my-bookings">
                                <i class="fas fa-calendar-check" aria-hidden="true"></i>Lịch sử đặt phòng
                              </a>
                            </li>
                            <li>
                              <hr class="dropdown-divider" />
                            </li>
                            <li>
                              <form method="post" action="/logout">
                                <button class="dropdown-item account-menu-link account-menu-logout text-danger" type="submit">
                                  <i class="fas fa-sign-out-alt" aria-hidden="true"></i>Đăng xuất
                                </button>
                              </form>
                            </li>
                          </ul>
                        </div>
                        <% } else { %>
                          <a href="/login" class="a-login">
                            <i class="fas fa-user fa-2x text-white"></i>
                          </a>
                          <% } %>
                    </div>
                  </div>
                </nav>
            </div>
        </div>
      </div>
      <!-- Header End -->

      <!-- Content will be inserted here by other pages -->
    </div>
  </div>
</body>

</html>