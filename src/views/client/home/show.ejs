              <div class="team-avatar team-avatar-ai mx-auto" role="img" aria-label="Avatar AI">
                <span aria-hidden="true">AI</span>
              </div>
            </div>
            <div class="text-center px-4 pb-4">
              <h5 class="fw-bold mb-0">AI</h5>

            </div>
          </div>
