<%- include('../layout/header'); -%>

<div
  class="container-fluid page-header mb-5 p-0"
  style="background-image: url(/client/img/carousel-1.jpg)"
>
  <div class="container-fluid page-header-inner py-5">
    <div class="container text-center pb-5">
      <h1 class="display-3 text-white mb-3 animated slideInDown">
        Chi Tiết Phòng
      </h1>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb justify-content-center text-uppercase">
          <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
          <li class="breadcrumb-item"><a href="/rooms">Phòng</a></li>
          <li class="breadcrumb-item text-white active" aria-current="page">
            <%= room.name %>
          </li>
        </ol>
      </nav>
    </div>
  </div>
</div>

<div class="container-xxl py-5">
  <div class="container">
    <div class="row g-5">
      <div class="col-lg-8">
        <div class="mb-4">
          <div class="position-relative">
            <img
              class="img-fluid w-100 rounded shadow-sm"
              src="<%= mainImage %>"
              alt="<%= room.name %>"
              style="object-fit: cover; height: 450px"
            />

            <% if (bookingCount > 0) { %>
            <div
              class="position-absolute top-0 end-0 bg-danger text-white px-3 py-2 m-3 rounded shadow"
            >
              <i class="fas fa-fire me-1"></i> Đã đặt <%= bookingCount %> lần
            </div>
            <% } else { %>
            <div
              class="position-absolute top-0 end-0 bg-success text-white px-3 py-2 m-3 rounded shadow"
            >
              <i class="fas fa-star me-1"></i> Phòng Mới
            </div>
            <% } %>
          </div>

        </div>

        <div class="mb-5">
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <h2 class="mb-0 text-primary"><%= room.name %></h2>
            <span class="badge bg-light text-dark border"><%= room.status %></span>
          </div>

          <div class="d-flex flex-wrap gap-3 mb-4 text-muted room-detail-facts">
            <span><i class="fa fa-bed me-2 text-primary"></i><%= room.type %></span>
            <span><i class="fa fa-user-friends me-2 text-primary"></i>Tối đa <%= room.capacity %> khách</span>
            <span><i class="fa fa-calendar-check me-2 text-primary"></i>Đã đặt <%= bookingCount %> lần</span>
          </div>

          <p
            class="text-body mb-4"
            style="line-height: 1.8; text-align: justify"
          >
            <%= description %>
          </p>
        </div>

      </div>

      <div class="col-lg-4">
        <div class="bg-white p-4 rounded shadow sticky-top room-booking-panel">
          <div class="border-bottom pb-3 mb-3">
            <small class="text-uppercase text-primary fw-bold"
              >Giá Tốt Nhất</small
            >
            <h2 class="display-6 text-danger mb-0">
              <%= room.price.toLocaleString('vi-VN') %>đ
              <small class="fs-6 text-dark fw-normal">/ đêm</small>
            </h2>
          </div>

          <p class="text-muted mb-4">Giá phòng được tính theo đêm. Chọn ngày lưu trú để xem phòng còn trống.</p>

          <a
            href="/booking?roomId=<%= room.id %>"
            class="btn btn-primary w-100 py-3 mb-3"
          >
            <i class="fa fa-calendar-check me-2"></i> ĐẶT PHÒNG NGAY
          </a>

          <a
            href="/rooms"
            class="btn btn-outline-secondary w-100 py-2"
          >
            <i class="fa fa-arrow-left me-2"></i> Xem phòng khác
          </a>

          <div class="mt-4 pt-4 border-top text-center">
            <p class="mb-1 text-muted">Cần hỗ trợ?</p>
            <h5 class="fw-bold text-dark">
              <i class="fa fa-phone-alt me-2"></i>+012 231 222
            </h5>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../layout/footer'); -%>
